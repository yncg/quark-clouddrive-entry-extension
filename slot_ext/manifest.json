{
  "name": "夸克网盘",
  "short_name": "夸克网盘",
  "version": "5.0.0",
  "description": "点一下云朵图标直接打开夸克网盘首页。",
  "manifest_version": 3,
  "key": "",
  "incognito": "not_allowed",
  "permissions": [
    "storage",
    "tabs",
    "quarkRoutePrivate"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "夸克网盘",
    "default_icon": {
      "16": "sniff.png",
      "24": "sniff.png",
      "32": "sniff.png"
